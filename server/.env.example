# MongoDB connection string.
# Local:  mongodb://localhost:27017/vi-fishing-map
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
MONGODB_URI=mongodb://localhost:27017/vi-fishing-map

# Secret used to sign JWTs. Use a long random string in production
# (e.g. `openssl rand -hex 32`) — never reuse this example value.
JWT_SECRET=replace-with-a-long-random-string

# Optional. Defaults to 3001 if unset.
PORT=3001

# Optional — restricts CORS to this origin in production.
# Leave unset in development.
# CLIENT_ORIGIN=https://your-deployed-frontend.example.com
